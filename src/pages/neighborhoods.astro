---
import Layout from '../layouts/Layout.astro';
import NeighborhoodTable from '../components/NeighborhoodTable.astro';
import { neighborhoods, listingsIn, formatCompactPrice, formatPrice, listingUrl, shortAddress, statusLabel, content, agents, agentUrl } from '../lib/data';
import { brand } from '../lib/brand';
---
<Layout title="Neighborhoods" description={`Market medians and local guides for the ${neighborhoods.length} South Coast neighborhoods ${brand.brokerageName} works in.`}>
  <div class="wrap pt-12 md:pt-20">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h1 class="t-display lg:col-span-7">Where we sell, and what it costs</h1>
      <p class="text-ink-muted lg:col-span-4 lg:col-start-9">
        Medians for single-family sales, {content.home.neighborhoodsAsOf}, from the Santa Barbara MLS. We update them every quarter.
      </p>
    </div>

    <div class="mt-14 max-w-4xl">
      <NeighborhoodTable asOf={content.home.neighborhoodsAsOf} linkBase="" />
    </div>

    <div class="mt-24 pb-28 md:mt-32 md:pb-36">
      {neighborhoods.map((n) => {
        const homes = listingsIn(n.slug);
        const experts = agents.filter((a) => a.areas.includes(n.slug));
        return (
          <section id={n.slug} class="rule grid scroll-mt-24 gap-8 py-14 lg:grid-cols-12 lg:gap-8 lg:py-20" aria-labelledby={`${n.slug}-h`}>
            <div class="lg:col-span-4">
              <h2 id={`${n.slug}-h`} class="t-title">{n.name}</h2>
              <dl class="num mt-6 flex gap-10">
                <div><dt class="text-sm text-ink-muted">Median sale</dt><dd class="mt-1 font-display text-xl">{formatCompactPrice(n.medianPrice)}</dd></div>
                <div><dt class="text-sm text-ink-muted">Days on market</dt><dd class="mt-1 font-display text-xl">{n.medianDays}</dd></div>
              </dl>
            </div>
            <div class="lg:col-span-7 lg:col-start-6">
              <p class="font-display text-xl leading-snug">{n.summary}</p>
              <p class="mt-5 max-w-[38rem] text-ink-muted">{n.body}</p>

              {homes.length > 0 && (
                <ul class="mt-8 max-w-[38rem]">
                  {homes.map((l) => (
                    <li class="rule">
                      <a href={listingUrl(l)} class="row-link flex flex-wrap items-baseline justify-between gap-x-6 py-3">
                        <span class="font-medium">{shortAddress(l)}</span>
                        <span class="num text-ink-muted">{statusLabel[l.status]}, {formatPrice(l)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {experts.length > 0 && (
                <p class="mt-6 text-[0.95rem]">
                  <span class="text-ink-muted">Ask about {n.name}: </span>
                  {experts.map((a, i) => (<>{i > 0 && ' or '}<a class="link" href={agentUrl(a)}>{a.name}</a></>))}
                </p>
              )}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .row-link { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.22em; transition: text-decoration-color 160ms ease; }
  .row-link:hover { text-decoration-color: var(--c-accent); }
</style>
