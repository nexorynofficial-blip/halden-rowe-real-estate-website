---
import Layout from '../../layouts/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { listings, neighborhoods, sortListings } from '../../lib/data';

const sorted = sortListings(listings);
const rhythm = (i: number) => (i % 7 === 0 || i % 7 === 6 ? 'lg' : 'md');
const hoods = neighborhoods.map((n) => ({ ...n, count: listings.filter((l) => l.neighborhood === n.slug).length })).filter((n) => n.count > 0);

const priceOptions = {
  sale: [
    { value: '', label: 'Any price' },
    { value: '0-3000000', label: 'Under $3M' },
    { value: '3000000-5000000', label: '$3M to $5M' },
    { value: '5000000-8000000', label: '$5M to $8M' },
    { value: '8000000-', label: 'Over $8M' },
  ],
  lease: [
    { value: '', label: 'Any rent' },
    { value: '0-10000', label: 'Under $10,000/mo' },
    { value: '10000-', label: '$10,000/mo and up' },
  ],
};
---
<Layout title="Homes for sale and lease" description={`Browse ${listings.length} homes for sale and lease across Santa Barbara, Montecito, Hope Ranch and Ojai.`}>
  <div class="wrap pt-12 md:pt-20">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h1 class="t-display lg:col-span-7">Homes for sale and lease</h1>
      <p class="text-ink-muted lg:col-span-4 lg:col-start-9">
        Every home here is shown by the agent who listed it. Book a tour from any listing and pick a time that's actually open.
      </p>
    </div>

    <!-- Inline filter bar -->
    <form class="filters mt-12 rounded-[var(--radius-panel)] bg-surface p-5 shadow-[var(--shadow-panel)] md:mt-14 md:p-7" data-filters role="search" aria-label="Filter listings" action="/listings/" method="get">
      <fieldset class="f-status">
        <legend class="field-label">Status</legend>
        <div class="flex flex-wrap gap-2">
          {[['', 'Any'], ['for-sale', 'For sale'], ['for-rent', 'For lease'], ['pending', 'Pending']].map(([v, label]) => (
            <label class="choice"><input type="radio" name="status" value={v} checked={v === ''} /><span>{label}</span></label>
          ))}
        </div>
      </fieldset>

      <div class="f-grid">
        <div>
          <label class="field-label" for="f-hood">Neighborhood</label>
          <select class="field" id="f-hood" name="hood">
            <option value="">All neighborhoods</option>
            {hoods.map((n) => <option value={n.slug}>{n.name} ({n.count})</option>)}
          </select>
        </div>
        <div>
          <label class="field-label" for="f-price">Price</label>
          <select class="field" id="f-price" name="price" data-sale={JSON.stringify(priceOptions.sale)} data-lease={JSON.stringify(priceOptions.lease)}>
            {priceOptions.sale.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
        <div>
          <label class="field-label" for="f-beds">Bedrooms</label>
          <select class="field" id="f-beds" name="beds">
            <option value="">Any</option>
            {[2, 3, 4, 5].map((n) => <option value={n}>{n}+ bedrooms</option>)}
          </select>
        </div>
        <div>
          <label class="field-label" for="f-sort">Sort by</label>
          <select class="field" id="f-sort" name="sort">
            <option value="">Featured first</option>
            <option value="newest">Newest listed</option>
            <option value="price-desc">Price, high to low</option>
            <option value="price-asc">Price, low to high</option>
          </select>
        </div>
      </div>
      <noscript><button class="btn btn-primary mt-4" type="submit">Apply filters</button></noscript>
    </form>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="font-medium num" data-count aria-live="polite">{listings.length} homes</p>
      <div class="flex flex-wrap items-center gap-2" data-pills role="group" aria-label="Active filters"></div>
    </div>

    <div class="lgrid mt-10 pb-28 md:pb-36" data-rhythm="index" data-grid>
      {sorted.map((l, i) => (
        <ListingCard listing={l} size={rhythm(i)} data-trailing={i % 7 === 6 ? true : undefined} headingLevel="h2" priority={i < 1} sizes={rhythm(i) === 'lg' ? '(min-width: 1024px) 62vw, 100vw' : '(min-width: 1024px) 30vw, (min-width: 768px) 50vw, 100vw'} />
      ))}
    </div>

    <div data-empty hidden class="-mt-16 mb-32 max-w-2xl rounded-ui border border-line bg-surface p-8 md:p-10">
      <h2 class="t-title">No listings match these filters right now.</h2>
      <p class="mt-4 text-ink-muted" data-empty-detail></p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <button type="button" class="btn btn-primary" data-clear>Clear filters</button>
        <a class="link font-medium" href="/contact/?path=buying">Tell us what you're looking for</a>
      </div>
      <p class="mt-6 text-[0.95rem] text-ink-muted">About a third of the homes we sell never reach this page. Our agents hear about them first.</p>
    </div>
  </div>
</Layout>

<style>
  .filters { display: grid; gap: 1.5rem; }
  .f-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (min-width: 1024px) {
    .filters { grid-template-columns: auto 1fr; align-items: end; gap: 2rem; }
    .f-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  :global(.pill) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.3rem 0.5rem 0.3rem 0.85rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-ui);
    background: var(--c-surface);
    font-size: 0.92rem;
    font-weight: 520;
  }
  :global(.pill button) {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-ui);
    color: var(--c-ink-muted);
  }
  :global(.pill button:hover) { background: var(--c-base); color: var(--c-ink); }
  :global(.pill-clear) { min-height: 2.5rem; padding: 0 0.5rem; font-size: 0.92rem; font-weight: 560; text-decoration: underline; text-underline-offset: 0.22em; color: var(--c-accent-text); }
</style>

<script>
  import { track } from '../../scripts/core';

  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;
  const pillsEl = document.querySelector<HTMLElement>('[data-pills]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const priceSel = form.querySelector<HTMLSelectElement>('#f-price')!;
  const original = cards.map((c) => c.dataset.id!);

  type State = { status: string; hood: string; price: string; beds: string; sort: string };
  const KEYS: (keyof State)[] = ['status', 'hood', 'price', 'beds', 'sort'];

  const read = (): State => {
    const fd = new FormData(form);
    return Object.fromEntries(KEYS.map((k) => [k, String(fd.get(k) ?? '')])) as State;
  };

  const write = (s: Partial<State>) => {
    if (s.status !== undefined) {
      const r = form.querySelector<HTMLInputElement>(`input[name="status"][value="${CSS.escape(s.status)}"]`);
      if (r) r.checked = true;
      syncPriceOptions(s.status);
    }
    for (const k of ['hood', 'price', 'beds', 'sort'] as const) {
      if (s[k] === undefined) continue;
      const sel = form.elements.namedItem(k) as HTMLSelectElement;
      sel.value = [...sel.options].some((o) => o.value === s[k]) ? s[k]! : '';
    }
  };

  // Rent and sale prices aren't comparable, so the price menu switches with status.
  function syncPriceOptions(status: string) {
    const kind = status === 'for-rent' ? 'lease' : 'sale';
    if (priceSel.dataset.kind === kind) return;
    const opts: { value: string; label: string }[] = JSON.parse(priceSel.dataset[kind]!);
    const prev = priceSel.value;
    priceSel.replaceChildren(...opts.map((o) => new Option(o.label, o.value)));
    priceSel.value = opts.some((o) => o.value === prev) ? prev : '';
    priceSel.dataset.kind = kind;
  }

  const esc = (t: string) => t.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const label = (k: keyof State, s: State) => {
    if (k === 'status') return form.querySelector<HTMLInputElement>(`input[name="status"][value="${CSS.escape(s.status)}"]`)?.nextElementSibling?.textContent ?? '';
    const sel = form.elements.namedItem(k) as HTMLSelectElement;
    const text = sel.selectedOptions[0]?.textContent ?? '';
    return k === 'hood' ? text.replace(/\s*\(\d+\)$/, '') : text;
  };

  function apply(push = true) {
    const s = read();
    const [min, max] = s.price ? s.price.split('-').map((v) => (v === '' ? null : Number(v))) : [null, null];
    const priceKind = s.status === 'for-rent' ? 'month' : 'total';

    const match = (c: HTMLElement) => {
      const d = c.dataset;
      if (s.status && d.status !== s.status) return false;
      if (s.hood && d.hood !== s.hood) return false;
      if (s.beds && Number(d.beds) < Number(s.beds)) return false;
      if (s.price) {
        if (d.unit !== priceKind) return false;
        const p = Number(d.price);
        if (min !== null && p < min) return false;
        if (max !== null && p >= max) return false;
      }
      return true;
    };

    const visible = cards.filter(match);
    const order = [...visible].sort((a, b) => {
      switch (s.sort) {
        case 'newest': return b.dataset.listed!.localeCompare(a.dataset.listed!);
        case 'price-desc': return (b.dataset.unit === 'month' ? 0 : Number(b.dataset.price)) - (a.dataset.unit === 'month' ? 0 : Number(a.dataset.price)) || Number(b.dataset.price) - Number(a.dataset.price);
        case 'price-asc': return (a.dataset.unit === 'month' ? 0 : 1) - (b.dataset.unit === 'month' ? 0 : 1) || Number(a.dataset.price) - Number(b.dataset.price);
        default: return original.indexOf(a.dataset.id!) - original.indexOf(b.dataset.id!);
      }
    });

    cards.forEach((c) => (c.hidden = true));
    order.forEach((c, i) => {
      c.hidden = false;
      const lg = i % 7 === 0 || i % 7 === 6;
      c.dataset.size = lg ? 'lg' : 'md';
      if (i % 7 === 6) c.dataset.trailing = 'true'; else delete c.dataset.trailing;
      grid.appendChild(c);
    });

    const n = order.length;
    countEl.textContent = n === 1 ? '1 home' : `${n} homes`;
    empty.hidden = n > 0;
    grid.hidden = n === 0;
    if (n === 0) {
      const parts = KEYS.filter((k) => k !== 'sort' && s[k]).map((k) => label(k, s).toLowerCase());
      empty.querySelector('[data-empty-detail]')!.textContent =
        `You're filtering by ${parts.join(', ')}. Removing one usually brings homes back.`;
    }

    // Removable pills for every active filter.
    const active = KEYS.filter((k) => k !== 'sort' && s[k]);
    pillsEl.innerHTML = active
      .map((k) => {
        const text = esc(k === 'beds' ? `${s.beds}+ beds` : label(k, s));
        return `<span class="pill">${text}<button type="button" data-remove="${k}" aria-label="Remove filter: ${text}"><svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.4"/></svg></button></span>`;
      })
      .join('') + (active.length > 1 ? `<button type="button" class="pill-clear" data-clear>Clear all</button>` : '');

    if (push) {
      const params = new URLSearchParams();
      KEYS.forEach((k) => s[k] && params.set(k, s[k]));
      const q = params.toString();
      history.replaceState(null, '', q ? `?${q}` : location.pathname);
      track('filter_applied', { ...s, results: n });
    }
  }

  const clear = () => {
    write({ status: '', hood: '', price: '', beds: '', sort: read().sort });
    apply();
    form.querySelector<HTMLInputElement>('input[name="status"]')?.focus();
  };

  form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'status') syncPriceOptions(read().status);
    apply();
  });
  form.addEventListener('submit', (e) => { e.preventDefault(); apply(); });
  pillsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    if (btn.hasAttribute('data-clear')) return clear();
    const k = btn.dataset.remove as keyof State;
    write({ [k]: '' });
    apply();
    (pillsEl.querySelector('button') as HTMLElement | null ?? countEl).focus?.();
  });
  empty.querySelector('[data-clear]')!.addEventListener('click', clear);

  // Restore state from the URL (e.g. breadcrumb links like ?hood=montecito).
  const params = new URLSearchParams(location.search);
  write(Object.fromEntries(KEYS.map((k) => [k, params.get(k) ?? ''])) as State);
  apply(false);
</script>
