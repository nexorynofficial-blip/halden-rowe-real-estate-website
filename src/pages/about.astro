---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { brand, fill } from '../lib/brand';
import { content, agents, agentUrl, listings } from '../lib/data';
const about = content.about;
---
<Layout title="About" description={brand.description}>
  <div class="wrap pt-12 md:pt-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-6">
        <h1 class="t-display max-w-[14ch]">{about.heading}</h1>
        <div class="prose-body mt-10 max-w-[36rem] text-[1.08rem] leading-[1.7]">
          {about.paragraphs.map((p) => <p>{fill(p)}</p>)}
        </div>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <div class="overflow-hidden rounded-ui">
          <Photo src={listings[0].images[1]?.src ?? brand.heroImage} alt={listings[0].images[1]?.alt ?? ''} sizes="(min-width: 1024px) 38vw, 100vw" priority class="aspect-[4/5] w-full object-cover" />
        </div>
      </div>
    </div>

    <section class="mt-28 md:mt-40" aria-labelledby="how-h">
      <h2 id="how-h" class="t-title">How we work</h2>
      <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        {about.principles.map((p) => (
          <li class="rule pt-6">
            <h3 class="text-xl leading-tight">{p.title}</h3>
            <p class="mt-3 text-ink-muted">{p.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-28 pb-28 md:mt-40 md:pb-36" aria-labelledby="team-h">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="team-h" class="t-title">Who you’ll work with</h2>
        <a href="/agents/" class="link font-medium">All agent profiles</a>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
        {agents.map((a) => (
          <li>
            <a href={agentUrl(a)} class="group block">
              <div class="overflow-hidden rounded-ui">
                <Photo src={a.photo} alt="" sizes="(min-width: 768px) 22vw, 46vw" widths={[320, 480, 640]} class="aspect-[4/5] w-full object-cover" />
              </div>
              <p class="mt-4 font-display text-lg leading-tight group-hover:underline underline-offset-4 decoration-1">{a.name}</p>
              <p class="text-sm text-ink-muted">{a.title}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
