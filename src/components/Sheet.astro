---
/**
 * A home-page section drawn as a sheet in a listing folder: rounded top corners,
 * its own palette tone, and a folder tab that names the section and carries one
 * live fact about it. Each sheet overlaps the one before it and, where supported,
 * rises over it as it scrolls into view.
 */
interface Props {
  tone: 'white' | 'platinum' | 'base' | 'ink';
  tab: string;
  meta?: string;
  id?: string;
  last?: boolean;
  first?: boolean;
}
const { tone, tab, meta, id, last = false, first = false } = Astro.props;
---
<div class:list={['sheet', { 'scope-dark on-dark': tone === 'ink', last, first }]} data-tone={tone} id={id}>
  <div class="sheet-tab" aria-hidden="true">
    <span class="tab-dot"></span>
    <span class="tab-label">{tab}</span>
    {meta && <span class="tab-meta num">{meta}</span>}
  </div>
  <div class="sheet-body">
    <slot />
  </div>
</div>

<style>
  .sheet {
    --sheet-bg: var(--c-surface);
    --tab-h: 3rem;
    --r: 32px;
    position: relative;
    margin-top: calc(-1 * var(--r) - 0.5rem);
    padding-top: var(--tab-h);
    background: var(--sheet-bg);
    border-radius: var(--r) var(--r) 0 0;
    box-shadow: 0 -1px 0 rgb(20 35 52 / 0.06), 0 -22px 44px -30px rgb(20 35 52 / 0.35);
    /* Clip sideways only, so decorations can't widen the page while the tab still pokes out the top. */
    overflow-x: clip;
  }
  .sheet.first { margin-top: 4rem; }
  .sheet.last { border-radius: var(--r); padding-bottom: 0.5rem; margin-bottom: 0.75rem; }
  @media (min-width: 768px) {
    .sheet { --r: 44px; }
    .sheet.first { margin-top: 5.5rem; }
    .sheet.last { margin-inline: 0.75rem; }
  }
  .sheet[data-tone='platinum'] { --sheet-bg: var(--c-base-deep); }
  .sheet[data-tone='base'] { --sheet-bg: var(--c-base); }
  /* Dark sheet: the scoped dark tone flips the tokens inside it (see .scope-dark in global.css). */
  .sheet[data-tone='ink'] { --sheet-bg: var(--c-deep); }

  .sheet-body { padding-bottom: calc(var(--r) + 5rem); }
  /* Sections placed in a sheet drop their own large top spacing; the tab and sheet edge do that job. */
  .sheet-body > :global(section:first-child), .sheet-body > :global(div:first-child > section:first-child) { padding-top: 3.5rem; }
  @media (min-width: 768px) { .sheet-body > :global(section:first-child), .sheet-body > :global(div:first-child > section:first-child) { padding-top: 4.5rem; } }
  @media (min-width: 768px) { .sheet-body { padding-bottom: calc(var(--r) + 7rem); } }
  .sheet.last .sheet-body { padding-bottom: 3rem; }

  /* Folder tab: sits on the sheet's top edge, joined to it with inverted corners. */
  .sheet-tab {
    position: absolute;
    top: calc(-1 * var(--tab-h) + 1px);
    left: max(1.25rem, calc((100vw - 88rem) / 2 + 1.25rem));
    height: var(--tab-h);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1.25rem 0 1.05rem;
    background: var(--sheet-bg);
    border-radius: 18px 18px 0 0;
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
  }
  @media (min-width: 768px) { .sheet-tab { left: max(2rem, calc((100vw - 88rem) / 2 + 2rem)); } }
  @media (min-width: 1280px) { .sheet-tab { left: max(3rem, calc((100vw - 88rem) / 2 + 3rem)); } }
  .sheet.last .sheet-tab { left: max(1.25rem, calc((100vw - 88rem) / 2 + 0.5rem)); }
  .sheet-tab::before, .sheet-tab::after {
    content: '';
    position: absolute;
    bottom: 0;
    width: 18px;
    height: 18px;
    background: var(--sheet-bg);
  }
  .sheet-tab::before { left: -18px; -webkit-mask: radial-gradient(circle at 0 0, transparent 18px, #000 18.5px); mask: radial-gradient(circle at 0 0, transparent 18px, #000 18.5px); }
  .sheet-tab::after { right: -18px; -webkit-mask: radial-gradient(circle at 100% 0, transparent 18px, #000 18.5px); mask: radial-gradient(circle at 100% 0, transparent 18px, #000 18.5px); }
  .tab-dot { width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: var(--c-accent); }
  .tab-meta { font-weight: 500; color: var(--c-ink-muted); padding-left: 0.6rem; border-left: 1px solid var(--c-line-strong); }

  /* The sheet rises over the previous one as it enters (scroll-driven, GPU-only). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .sheet:not(.first) {
        animation: sheet-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }
    }
  }
  @keyframes sheet-rise {
    from { transform: translateY(3.5rem) scale(0.985); }
    to { transform: none; }
  }
</style>
