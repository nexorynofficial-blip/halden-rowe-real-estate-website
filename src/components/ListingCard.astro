---
import Photo from './Photo.astro';
import StatusTag from './StatusTag.astro';
import {
  type Listing, formatPrice, formatBaths, formatNumber, shortAddress, listingUrl, getNeighborhood,
} from '../lib/data';

interface Props {
  listing: Listing;
  size?: 'lg' | 'md';
  sizes?: string;
  headingLevel?: 'h2' | 'h3';
  class?: string;
  priority?: boolean;
  [key: `data-${string}`]: unknown;
}
const { listing: l, size = 'md', sizes, headingLevel = 'h3', class: cls = '', priority = false, ...rest } = Astro.props;
const H = headingLevel;
const hood = getNeighborhood(l.neighborhood);
const cover = l.images[0];
const imgSizes = sizes ?? (size === 'lg' ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 1024px) 30vw, (min-width: 768px) 50vw, 100vw');
---
<article
  {...rest}
  class:list={['card', cls]}
  data-size={size}
  data-id={l.id}
  data-status={l.status}
  data-price={l.price}
  data-unit={l.priceUnit ?? 'total'}
  data-beds={l.bedrooms}
  data-hood={l.neighborhood}
  data-listed={l.listedDate}
  data-featured={String(l.featured)}
>
  <a href={listingUrl(l)} class="card-link" data-prefetch>
    <div class="media">
      <Photo src={cover.src} alt="" sizes={imgSizes} class="media-img" priority={priority} />
      <span class="chip"><StatusTag status={l.status} /></span>
      <span class="reveal" aria-hidden="true">View details</span>
    </div>
    <div class="meta">
      <p class="hood">{hood.name}</p>
      <div class="title-row">
        <H class="addr">{shortAddress(l)}</H>
        <p class="price num">{formatPrice(l)}</p>
      </div>
      <p class="specs num">
        <span><b>{l.bedrooms}</b> beds</span>
        <span><b>{formatBaths(l.bathrooms)}</b> baths</span>
        <span><b>{formatNumber(l.sqft)}</b> sq ft</span>
      </p>
      {size === 'lg' && <p class="summary">{l.summary}</p>}
    </div>
  </a>
</article>

<style>
  .card-link { display: block; border-radius: var(--radius-ui); }
  .media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-ui);
    background: var(--c-base-deep);
    aspect-ratio: 4 / 3;
    transition: transform 380ms var(--ease-out-soft), box-shadow 380ms var(--ease-out-soft);
  }
  .media :global(picture), .media :global(img) { display: block; width: 100%; height: 100%; }
  .media :global(img) { object-fit: cover; transition: transform 900ms var(--ease-out-soft); }
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(14 22 33 / 0.55), rgb(14 22 33 / 0) 55%);
    opacity: 0;
    transition: opacity 320ms ease;
  }
  .reveal {
    position: absolute;
    left: 1.1rem;
    bottom: 1rem;
    z-index: 1;
    color: var(--c-on-photo);
    font-size: 0.95rem;
    font-weight: 560;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 280ms ease, transform 320ms var(--ease-out-soft);
  }

  @media (hover: hover) and (pointer: fine) {
    .card-link:hover .media { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
    .card-link:hover .media :global(img) { transform: scale(1.035); }
    .card-link:hover .media::after, .card-link:hover .reveal { opacity: 1; }
    .card-link:hover .reveal { transform: none; }
  }
  .card-link:focus-visible .media::after, .card-link:focus-visible .reveal { opacity: 1; transform: none; }

  .meta { padding-top: 1.1rem; }
  .chip { position: absolute; top: 0.85rem; left: 0.85rem; z-index: 1; }
  .chip :global(.status) { border-radius: 9999px; padding-inline: 0.7rem; box-shadow: 0 4px 14px -6px rgb(14 22 33 / 0.4); }
  .chip :global(.status[data-status='for-sale']), .chip :global(.status[data-status='for-rent']) { background: var(--c-surface); }
  .hood { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; color: var(--c-ink-muted); }
  .title-row { margin-top: 0.3rem; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: 1rem; row-gap: 0.15rem; }
  .addr { font-size: 1.55rem; line-height: 1.1; letter-spacing: -0.022em; }
  .price { font-size: 1.05rem; font-weight: 700; color: var(--c-ink); white-space: nowrap; }
  .specs { margin-top: 0.4rem; display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; font-size: 0.95rem; color: var(--c-ink-muted); }
  .specs b { font-weight: 600; color: var(--c-ink); }
  .summary { margin-top: 0.75rem; max-width: 36rem; color: var(--c-ink-muted); }

  .card[data-size='md'] .title-row { flex-direction: column; align-items: flex-start; }
  @media (max-width: 767px) { .card[data-size='md'] .title-row { flex-direction: row; align-items: baseline; } }

  /* Large tiles: wider image, larger address. */
  @media (min-width: 768px) {
    .card[data-size='lg'] .media { aspect-ratio: 16 / 10; }
    .card[data-size='lg'] .addr { font-size: 2.1rem; }
    .card[data-size='lg'] .price { font-size: 1.2rem; }
    .card[data-size='md'] .media { aspect-ratio: 4 / 3; }
  }
  @media (min-width: 1024px) {
    .card[data-size='md'] .media { aspect-ratio: 4 / 5; }
    .card[data-size='md'][data-shape='wide'] .media { aspect-ratio: 4 / 3; }
  }
</style>
