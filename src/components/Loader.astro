---
/**
 * First-visit loading screen: a pair of paneled doors. The seal draws itself on the
 * seam and the name rises letter by letter while a fine line fills down the seam as
 * the page really loads (fonts + the hero image). Then the name lifts away and the
 * doors part to reveal the home page. Shown once per browser session; add ?intro to
 * any URL to replay it. Without JavaScript it never appears. With reduced motion the
 * doors simply fade.
 */
import { brand } from '../lib/brand';
const letters = [...brand.logo.wordmark];
---
<div class="loader" data-loader aria-hidden="true">
  <div class="door door-l"></div>
  <div class="door door-r"></div>
  <span class="seam seam-t"><span class="seam-fill" data-loader-bar="t"></span></span>
  <span class="seam seam-b"><span class="seam-fill" data-loader-bar="b"></span></span>

  <div class="stage">
    <svg class="seal" viewBox="0 0 120 120" width="88" height="88">
      <circle class="ring ring-outer" cx="60" cy="60" r="56" pathLength="1" />
      <circle class="ring ring-inner" cx="60" cy="60" r="47" pathLength="1" />
      <text class="seal-mono" x="60" y="69" text-anchor="middle">{brand.logo.monogram}</text>
    </svg>
    <p class="word">
      {letters.map((c, i) => (
        <span class="ch" style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>
      ))}
    </p>
    <p class="desc">{brand.market} {brand.logo.descriptor.toLowerCase()}</p>
  </div>

  <div class="foot">
    <p class="count"><span class="num" data-loader-pct>0</span><span class="pc">%</span></p>
    <p class="since">Since {brand.founded}</p>
  </div>
</div>

<!-- The show/skip decision runs in <head> (Layout.astro) so the loader never flashes. -->

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    color: var(--c-deep-text);
    /* Per-frame updates inside never re-lay-out the page underneath. */
    contain: strict;
  }
  :global(html.is-loading) .loader { display: block; }
  .loader.leaving { pointer-events: none; }

  /* Two paneled doors. */
  .door {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50.2%;
    background-color: var(--c-deep);
    will-change: transform;
  }
  .door-l { left: 0; }
  .door-r { right: 0; }
  /* Inset panel outline, like the recessed panel of a front door. */
  .door::before {
    content: '';
    position: absolute;
    top: 9svh;
    bottom: 9svh;
    border: 1px solid color-mix(in srgb, var(--c-deep-text) 11%, transparent);
  }
  .door-l::before { left: 7vw; right: 2.2vw; }
  .door-r::before { left: 2.2vw; right: 7vw; }

  /* The seam: a hairline down the centre that fills as the page loads. Hidden behind the name. */
  .seam {
    position: absolute;
    left: 50%;
    width: 1px;
    margin-left: -0.5px;
    height: 27%;
    background: color-mix(in srgb, var(--c-deep-text) 14%, transparent);
  }
  .seam-t { top: 0; }
  .seam-b { bottom: 0; }
  .seam-fill { display: block; height: 100%; width: 100%; background: var(--c-accent-on-dark); transform-origin: top; transform: scaleY(0); will-change: transform; }

  .stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .seal { overflow: visible; }
  .ring { fill: none; stroke-dasharray: 1; stroke-dashoffset: 1; transform: rotate(-90deg); transform-origin: 60px 60px; stroke-width: 1.2; }
  .ring-outer { stroke: color-mix(in srgb, var(--c-deep-text) 80%, transparent); animation: ring 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.1s forwards; }
  .ring-inner { stroke: var(--c-accent-on-dark); animation: ring 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards; }
  .seal-mono { fill: var(--c-deep-text); font-family: var(--f-display); font-size: 30px; font-weight: 500; letter-spacing: 0.04em; opacity: 0; animation: fade 0.6s ease 0.7s forwards; }

  .word {
    margin-top: 1.6rem;
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 1.5rem + 3vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    display: flex;
    overflow: hidden;
    padding-bottom: 0.1em;
  }
  .ch { display: inline-block; white-space: pre; transform: translateY(110%); animation: rise 0.85s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.55s + var(--i) * 0.045s) forwards; }
  .desc { margin-top: 0.9rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.24em; color: var(--c-accent-on-dark); opacity: 0; animation: fade 0.8s ease 1.15s forwards; }

  .foot {
    position: absolute;
    left: 0; right: 0; bottom: 1.6rem;
    display: flex; justify-content: space-between; align-items: baseline;
    padding-inline: max(1.25rem, calc((100vw - 88rem) / 2 + 3rem));
    font-size: 0.85rem;
    color: var(--c-on-dark-muted);
    contain: layout paint;
  }
  .count { font-family: var(--f-display); font-size: clamp(2.6rem, 2rem + 2vw, 4rem); line-height: 1; letter-spacing: -0.04em; color: var(--c-deep-text); min-width: 4ch; }
  .pc { font-family: var(--f-body); font-size: 0.9rem; letter-spacing: 0; margin-left: 0.2rem; color: var(--c-on-dark-muted); }

  /* Exit: the name lifts away, then the doors part. */
  .loader.leaving .stage { opacity: 0; transform: translateY(calc(-50% - 1.2rem)); transition: opacity 0.45s ease, transform 0.6s ease; }
  .loader.leaving .foot { opacity: 0; transform: translateY(-1rem); transition: opacity 0.45s ease, transform 0.6s ease; }
  .loader.leaving .seam { opacity: 0; transition: opacity 0.3s ease; }
  .loader.leaving .door-l { transform: translateX(-101%); transition: transform 1.2s cubic-bezier(0.76, 0, 0.24, 1) 0.3s; }
  .loader.leaving .door-r { transform: translateX(101%); transition: transform 1.2s cubic-bezier(0.76, 0, 0.24, 1) 0.3s; }
  .loader.leaving .door::before { opacity: 0; transition: opacity 0.3s ease; }

  @keyframes ring { to { stroke-dashoffset: 0; } }
  @keyframes rise { to { transform: none; } }
  @keyframes fade { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .ring { stroke-dashoffset: 0; animation: none; }
    .ch { transform: none; animation: none; }
    .seal-mono, .desc { opacity: 1; animation: none; }
    .loader.leaving .door-l, .loader.leaving .door-r { transform: none; opacity: 0; transition: opacity 0.4s ease; }
  }
</style>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('[data-loader]');
  if (loader && root.classList.contains('is-loading')) {
    const pctEl = loader.querySelector<HTMLElement>('[data-loader-pct]')!;
    const barT = loader.querySelector<HTMLElement>('[data-loader-bar="t"]')!;
    const barB = loader.querySelector<HTMLElement>('[data-loader-bar="b"]')!;
    // The hairline fills from the top, then continues below the name.
    const setBar = (p: number) => {
      barT.style.transform = `scaleY(${Math.min(1, p * 2)})`;
      barB.style.transform = `scaleY(${Math.max(0, p * 2 - 1)})`;
    };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MIN = reduced ? 400 : 2000; // long enough for the seal and name to finish
    const MAX = 3600; // never hold a visitor longer than this
    const start = performance.now();

    // Hold scrolling while the intro plays, without touching overflow (which would force a full relayout later).
    const block = (e: Event) => e.preventDefault();
    const keys = (e: KeyboardEvent) => { if ([' ', 'PageDown', 'PageUp', 'ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) e.preventDefault(); };
    addEventListener('wheel', block, { passive: false });
    addEventListener('touchmove', block, { passive: false });
    addEventListener('keydown', keys);
    const release = () => {
      removeEventListener('wheel', block);
      removeEventListener('touchmove', block);
      removeEventListener('keydown', keys);
    };

    // Real readiness: web fonts plus the first large image on the page.
    let ready = false;
    const heroImg = document.querySelector<HTMLImageElement>('main img');
    const imgReady = new Promise<void>((res) => {
      if (!heroImg || heroImg.complete) return res();
      heroImg.addEventListener('load', () => res(), { once: true });
      heroImg.addEventListener('error', () => res(), { once: true });
    });
    Promise.all([document.fonts?.ready ?? Promise.resolve(), imgReady]).then(() => { ready = true; });

    let shown = 0;
    let lastPct = 0;
    const tick = (now: number) => {
      const t = now - start;
      // Progress eases toward 90% on time alone, and only reaches 100% once things are actually loaded.
      const timeTarget = Math.min(0.9, t / MIN);
      const target = ready && t >= MIN ? 1 : timeTarget;
      shown += (target - shown) * 0.12;
      if (target === 1 && 1 - shown < 0.004) shown = 1;
      const pct = Math.round(shown * 100);
      if (pct !== lastPct) { lastPct = pct; pctEl.textContent = String(pct); }
      setBar(shown);
      if (shown >= 1 || t > MAX) return leave();
      requestAnimationFrame(tick);
    };
    const leave = () => {
      pctEl.textContent = '100';
      setBar(1);
      loader.classList.add('leaving');
      release();
      // The hero's own entrance starts as the doors begin to part (scoped to the hero, not <html>).
      setTimeout(() => document.querySelectorAll<HTMLElement>('[data-intro-wait]').forEach((el) => (el.dataset.introGo = '')), reduced ? 0 : 500);
      setTimeout(() => loader.remove(), reduced ? 450 : 1700);
    };
    requestAnimationFrame(tick);
  }
</script>
