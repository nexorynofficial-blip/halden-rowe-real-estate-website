---
import { Picture } from 'astro:assets';
import { img } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  widths?: number[];
  class?: string;
  pictureClass?: string;
  priority?: boolean;
  aspect?: number; // width / height crop, optional
}

const { src, alt, sizes, widths = [480, 720, 960, 1280, 1600], class: cls = '', pictureClass = '', priority = false, aspect } = Astro.props;
const meta = img(src);
const usable = widths.filter((w) => w <= meta.width);
const height = aspect ? Math.round(Math.max(...usable) / aspect) : undefined;
---
<Picture
  src={meta}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={usable}
  sizes={sizes}
  quality={aspect ? 62 : 64}
  width={aspect ? Math.max(...usable) : undefined}
  height={height}
  fit={aspect ? 'cover' : undefined}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : 'auto'}
  class={cls}
  pictureAttributes={pictureClass ? { class: pictureClass } : {}}
/>
