---
import Photo from '../Photo.astro';
import { agents, getAgent, agentUrl, listingsFor, getNeighborhood } from '../../lib/data';

interface Props { leadId: string; heading: string }
const { leadId, heading } = Astro.props;
const lead = getAgent(leadId);
const others = agents.filter((a) => a.id !== leadId).slice(0, 3);
const leadActive = listingsFor(lead.id).filter((l) => l.status !== 'pending').length;
const areas = (a: typeof lead) => a.areas.map((s) => getNeighborhood(s).name).join(', ');
---
<section class="wrap pt-28 md:pt-40" aria-labelledby="team-h">
  <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
    <h2 id="team-h" class="t-display max-w-[16ch] lg:col-span-7" data-reveal>
      {heading.split(/(?<=person )/).map((line, i) => <span class="rl" style={`--i:${i}`}><span>{line}</span></span>)}
    </h2>
    <div class="lg:col-span-4 lg:col-start-9" data-reveal-fade>
      <p class="text-ink-muted">Every home is shown by the agent who listed it. Book a call straight into their calendar.</p>
      <a href="/agents/" class="link mt-3 inline-block font-semibold">Meet all {agents.length} agents</a>
    </div>
  </div>

  <div class="mt-14 grid gap-5 lg:grid-cols-12">
    <!-- Lead agent: the full card. -->
    <article class="lead lg:col-span-6" data-reveal-fade>
      <div class="lead-photo" data-reveal-img>
        <Photo src={lead.photo} alt={lead.photoAlt} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 40vw, 100vw" widths={[480, 720]} class="h-full w-full object-cover" />
      </div>
      <div class="flex flex-col p-6 md:p-8">
        <p class="text-sm font-semibold text-brass-text">{lead.title}</p>
        <h3 class="mt-2 font-display text-[2.2rem] leading-none tracking-[-0.025em]">{lead.name}</h3>
        <p class="mt-4 text-ink-muted">{lead.shortBio}</p>
        <dl class="num mt-6 grid grid-cols-3 gap-4 border-t border-line pt-5">
          <div><dt class="text-[0.78rem] font-semibold tracking-[0.04em] text-ink-muted">Years</dt><dd class="font-display text-2xl" data-count={String(lead.yearsActive)}>{lead.yearsActive}</dd></div>
          <div><dt class="text-[0.78rem] font-semibold tracking-[0.04em] text-ink-muted">Sold</dt><dd class="font-display text-2xl" data-count={String(lead.homesSold)}>{lead.homesSold}</dd></div>
          <div><dt class="text-[0.78rem] font-semibold tracking-[0.04em] text-ink-muted">Listed now</dt><dd class="font-display text-2xl">{leadActive}</dd></div>
        </dl>
        <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-7">
          <a href={`${agentUrl(lead)}#book`} class="btn btn-dark">Book a call with {lead.firstName}</a>
          <a href={agentUrl(lead)} class="link font-semibold">Profile</a>
        </div>
      </div>
    </article>

    <!-- The rest of the team: portraits that open each agent's page. -->
    <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:col-span-6">
      {others.map((a, i) => (
        <li data-reveal-fade style={`--i:${i + 1}`}>
          <a href={agentUrl(a)} class="mate">
            <div class="mate-photo">
              <Photo src={a.photo} alt="" sizes="(min-width: 1024px) 14vw, (min-width: 640px) 30vw, 46vw" widths={[320, 480]} class="h-full w-full object-cover" />
            </div>
            <p class="mt-4 font-display text-xl leading-tight tracking-[-0.015em]">{a.name}</p>
            <p class="mt-1 text-sm text-ink-muted">{areas(a)}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lead {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: var(--c-surface);
    box-shadow: var(--shadow-panel);
  }
  @media (min-width: 640px) { .lead { grid-template-columns: 0.9fr 1.1fr; } }
  .lead-photo { aspect-ratio: 4 / 5; background: var(--c-base-deep); }
  @media (min-width: 640px) { .lead-photo { aspect-ratio: auto; min-height: 100%; } }
  .lead-photo :global(picture) { display: block; height: 100%; }

  .mate { display: block; border-radius: var(--radius-ui); }
  .mate-photo { aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius-panel); background: var(--c-base-deep); }
  .mate-photo :global(picture) { display: block; height: 100%; }
  .mate-photo :global(img) { transition: transform 900ms var(--ease-out-soft); }
  @media (hover: hover) and (pointer: fine) {
    .mate:hover .mate-photo :global(img) { transform: scale(1.05); }
    .mate:hover p:first-of-type { color: var(--c-accent-text); }
  }
</style>
