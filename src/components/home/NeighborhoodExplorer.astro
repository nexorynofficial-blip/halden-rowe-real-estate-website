---
/**
 * Neighborhood index. Each row carries the area's real medians; hovering or
 * focusing a row swaps the photograph beside the list (desktop). On touch screens
 * each row shows its own thumbnail instead.
 */
import Photo from '../Photo.astro';
import { neighborhoods, listingsIn, formatCompactPrice } from '../../lib/data';

interface Props { heading: string; intro: string; asOf: string }
const { heading, intro, asOf } = Astro.props;
const rows = neighborhoods
  .map((n) => {
    const homes = listingsIn(n.slug);
    return { ...n, img: homes[0]?.images[0], active: homes.filter((h) => h.status !== 'pending').length };
  })
  .filter((r) => r.img);
---
<section class="wrap pt-28 md:pt-40" aria-labelledby="hx-h" data-hx>
  <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
    <h2 id="hx-h" class="t-display lg:col-span-7" data-reveal>
      {heading.split(', ').map((part, i) => <span class="rl" style={`--i:${i}`}><span>{part}{i === 0 ? ',' : ''}</span></span>)}
    </h2>
    <div class="lg:col-span-4 lg:col-start-9" data-reveal-fade>
      <p class="text-ink-muted">{intro}</p>
      <p class="mt-3 text-sm text-ink-muted">Single-family medians, {asOf}. Source: Santa Barbara MLS.</p>
    </div>
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:gap-8">
    <ul class="lg:col-span-7" data-hx-list>
      {rows.map((n, i) => (
        <li class="hx-row" data-hx-row={i} data-active={i === 0 ? 'true' : undefined} data-reveal-fade style={`--i:${i}`}>
          <a href={`/neighborhoods/#${n.slug}`} class="hx-link">
            <span class="hx-name">{n.name}</span>
            <span class="hx-stats num">
              <span><span class="hx-k">Median</span> {formatCompactPrice(n.medianPrice)}</span>
              <span class="hidden sm:inline"><span class="hx-k">On market</span> {n.medianDays} days</span>
              <span><span class="hx-k">Listed</span> {n.active || 'None'}</span>
            </span>
            <span class="hx-thumb lg:hidden" aria-hidden="true">
              <Photo src={n.img!.src} alt="" sizes="96px" widths={[240]} class="h-full w-full object-cover" />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden lg:col-span-5 lg:block" aria-hidden="true">
      <div class="hx-stage" data-reveal-img>
        {rows.map((n, i) => (
          <figure class="hx-frame" data-hx-frame={i} data-active={i === 0 ? 'true' : undefined}>
            <Photo src={n.img!.src} alt="" sizes="38vw" widths={[720, 960]} class="h-full w-full object-cover" />
            <figcaption class="hx-cap">
              <span class="font-display text-2xl">{n.name}</span>
              <span class="mt-1 block text-[0.95rem] opacity-90">{n.summary}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hx-row { border-top: 1px solid var(--c-line); }
  .hx-row:last-child { border-bottom: 1px solid var(--c-line); }
  .hx-link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.35rem 1rem;
    padding: 1.05rem 0;
    position: relative;
  }
  .hx-name {
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    transition: color 200ms ease, transform 320ms var(--ease-out-soft);
  }
  .hx-stats { grid-column: 1; display: flex; flex-wrap: wrap; gap: 0.2rem 1.25rem; font-size: 0.92rem; color: var(--c-ink-muted); }
  .hx-k { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em; margin-right: 0.25rem; }
  .hx-thumb { grid-row: 1 / span 2; grid-column: 2; width: 5.5rem; height: 4.25rem; overflow: hidden; border-radius: var(--radius-ui); }
  .hx-thumb :global(picture) { display: block; height: 100%; }

  @media (min-width: 1024px) {
    .hx-link { grid-template-columns: 1fr auto; padding: 1.15rem 0; }
    .hx-stats { grid-column: 2; grid-row: 1; justify-content: flex-end; }
    .hx-row[data-active='true'] .hx-name { color: var(--c-accent-text); transform: translateX(0.5rem); }
  }

  .hx-stage { position: sticky; top: 7rem; aspect-ratio: 4 / 5; border-radius: var(--radius-panel); overflow: hidden; background: var(--c-base-deep); }
  .hx-frame { position: absolute; inset: 0; opacity: 0; transition: opacity 500ms ease; }
  .hx-frame[data-active='true'] { opacity: 1; }
  .hx-frame :global(picture) { display: block; height: 100%; }
  .hx-frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(14 22 33 / 0.75), rgb(14 22 33 / 0) 50%); }
  .hx-cap { position: absolute; left: 1.5rem; right: 1.5rem; bottom: 1.4rem; z-index: 1; color: var(--c-on-photo); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hx]').forEach((root) => {
    const rows = [...root.querySelectorAll<HTMLElement>('[data-hx-row]')];
    const frames = [...root.querySelectorAll<HTMLElement>('[data-hx-frame]')];
    const activate = (i: number) => {
      rows.forEach((r, n) => (n === i ? (r.dataset.active = 'true') : delete r.dataset.active));
      frames.forEach((f, n) => (n === i ? (f.dataset.active = 'true') : delete f.dataset.active));
    };
    rows.forEach((r, i) => {
      r.addEventListener('mouseenter', () => activate(i));
      r.addEventListener('focusin', () => activate(i));
    });
  });
</script>
