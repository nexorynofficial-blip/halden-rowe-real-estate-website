---
/** Featured homes: horizontally scrolling cards of varied width, chips over the photo, round controls. */
import Photo from '../Photo.astro';
import { type Listing, formatPrice, formatBaths, formatNumber, shortAddress, listingUrl, getNeighborhood, statusLabel } from '../../lib/data';

interface Props { items: Listing[]; heading: string; intro: string; total: number }
const { items, heading, intro, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="reel pt-24 md:pt-32" aria-labelledby="reel-h" data-reel>
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 id="reel-h" class="t-display" data-reveal><span class="rl"><span>{heading}</span></span></h2>
        <p class="mt-4 max-w-xl text-ink-muted" data-reveal-fade>{intro}</p>
      </div>
      <div class="flex items-center gap-3">
        <p class="num mr-1 text-sm text-ink-muted"><span aria-hidden="true">({pad(items.length)})</span><span class="sr-only">{items.length}</span> Featured listings</p>
        <button type="button" class="ctrl ctrl-outline" data-reel-prev aria-label="Previous homes" disabled>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <button type="button" class="ctrl ctrl-solid" data-reel-next aria-label="Next homes">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
      </div>
    </div>
  </div>

  <ul class="track mt-12" data-reel-track tabindex="0" aria-label={heading}>
    {items.map((l, i) => (
      <li class:list={['slide', { wide: i % 3 === 1 }]} data-slide data-reveal-fade style={`--i:${i}`}>
        <a href={listingUrl(l)} class="plate">
          <div class="plate-media">
            <Photo src={l.images[0].src} alt="" sizes="(min-width: 1024px) 40vw, (min-width: 640px) 60vw, 86vw" widths={[480, 720, 960, 1280]} class="h-full w-full object-cover" />
          </div>
          <span class="chips">
            <span class="chip" data-status={l.status}>{statusLabel[l.status]}</span>
            <span class="chip num">Price: {formatPrice(l)}</span>
            <span class="chip chip-place">Place: {getNeighborhood(l.neighborhood).name}</span>
          </span>
          <span class="plate-info">
            <span class="block font-display text-[1.6rem] font-medium leading-[1.1] tracking-[-0.025em] md:text-[1.85rem]">{shortAddress(l)}</span>
            <span class="num mt-1.5 block text-[0.95rem] text-[color-mix(in_srgb,var(--c-on-photo)_88%,transparent)]">
              {l.bedrooms} Beds | {formatBaths(l.bathrooms)} Baths | {formatNumber(l.sqft)} Sq Ft
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <div class="wrap mt-8">
    <a href="/listings/" class="btn btn-primary">See all {total} listings<span class="btn-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M3 9L9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span></a>
  </div>
</section>

<style>
  .track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-inline: max(1.25rem, calc((100vw - 88rem) / 2 + 1.25rem));
    scroll-padding-inline: max(1.25rem, calc((100vw - 88rem) / 2 + 1.25rem));
  }
  @media (min-width: 768px) {
    .track { padding-inline: max(2rem, calc((100vw - 88rem) / 2 + 2rem)); scroll-padding-inline: max(2rem, calc((100vw - 88rem) / 2 + 2rem)); }
  }
  @media (min-width: 1280px) {
    .track { padding-inline: max(3rem, calc((100vw - 88rem) / 2 + 3rem)); scroll-padding-inline: max(3rem, calc((100vw - 88rem) / 2 + 3rem)); }
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--c-ink); outline-offset: 4px; }

  /* Standard and wide cards share one height; widths vary. */
  .slide { flex: 0 0 86%; scroll-snap-align: start; height: 30rem; }
  @media (min-width: 640px) { .slide { flex-basis: 52%; } .slide.wide { flex-basis: 72%; } }
  @media (min-width: 1024px) { .slide { flex-basis: 24rem; height: 34rem; } .slide.wide { flex-basis: 40rem; } }

  .plate { position: relative; display: block; height: 100%; overflow: hidden; border-radius: var(--radius-panel); isolation: isolate; }
  .plate-media { position: absolute; inset: 0; background: var(--c-base-deep); }
  .plate-media :global(picture) { display: block; height: 100%; }
  .plate-media :global(img) { transition: transform 1s var(--ease-out-soft); }
  .plate::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(14 22 33 / 0.86) 0%, rgb(14 22 33 / 0.3) 34%, rgb(14 22 33 / 0) 55%);
    z-index: 0;
  }
  .chips { position: absolute; top: 1rem; left: 1rem; right: 1rem; z-index: 1; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    display: inline-flex; align-items: center;
    min-height: 2rem; padding: 0 0.85rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--c-surface) 90%, transparent);
    color: var(--c-ink);
    font-size: 0.82rem; font-weight: 600;
  }
  .chip[data-status='pending'] { background: var(--c-ink); color: var(--c-surface); }
  .chip-place { display: none; }
  .wide .chip-place { display: inline-flex; }
  .plate-info { position: absolute; left: 1.4rem; right: 1.4rem; bottom: 1.3rem; z-index: 1; color: var(--c-on-photo); }
  @media (hover: hover) and (pointer: fine) {
    .plate:hover .plate-media :global(img) { transform: scale(1.045); }
  }
  .plate:focus-visible { outline: 2px solid var(--c-ink); outline-offset: 3px; }

  .ctrl {
    display: grid; place-items: center;
    width: 2.9rem; height: 2.9rem; border-radius: 9999px;
    transition: background-color 160ms ease, color 160ms ease, opacity 160ms ease;
  }
  .ctrl-outline { border: 1px solid var(--c-line-strong); color: var(--c-ink); }
  .ctrl-outline:hover:not(:disabled) { border-color: var(--c-ink); }
  .ctrl-solid { background: var(--c-ink); color: var(--c-surface); }
  .ctrl-solid:hover:not(:disabled) { background: var(--c-secondary); }
  .ctrl:disabled { opacity: 0.35; cursor: default; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-reel-track]')!;
    const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-reel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-reel-next]');
    const pad = () => parseFloat(getComputedStyle(track).paddingLeft) || 0;
    // Index of the last slide whose start is at or before the current scroll position.
    const current = () => {
      const x = track.scrollLeft + 4;
      let i = 0;
      slides.forEach((s, n) => { if (s.offsetLeft - pad() <= x) i = n; });
      return i;
    };
    const go = (i: number) => {
      const s = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({ left: s.offsetLeft - pad() });
    };
    let raf = 0;
    const update = () => {
      raf = 0;
      const max = track.scrollWidth - track.clientWidth - 4;
      if (prev) prev.disabled = track.scrollLeft < 4;
      if (next) next.disabled = track.scrollLeft >= max;
    };
    track.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
    });
    update();
  });
</script>
