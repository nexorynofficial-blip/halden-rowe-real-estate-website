---
/**
 * Home hero: "from drawing to house".
 * An architect's elevation of the featured home draws itself in brass on ink,
 * then the photograph is revealed underneath it, with the lines landing on the
 * real building before they lift off. CSS + inline SVG only; no animation library.
 * Reduced motion: the photo is shown straight away, no drawing, no parallax.
 */
import { brand } from '../../lib/brand';
import { formatBaths, formatNumber, listingUrl, type Listing } from '../../lib/data';
import blueprints from '../../data/hero-blueprints.json';
import { buildTheme } from '../../lib/theme';
import HeroSearch from './HeroSearch.astro';

interface Props {
  listing: Listing;
  sources: { avif: string; webp: string; jpg: string; fallback: string; width: number; height: number };
}
const { listing: l, sources } = Astro.props;
const heroAlt = l.images.find((i) => i.src === brand.heroImage)?.alt ?? l.images[0].alt;

type Dim = { d: string; ticks: number[][]; label: string; x: number; y: number; anchor: string; rotate?: boolean; vertical?: boolean };
type Blueprint = { viewBox: string; structure: string[]; openings: string[]; landscape: string[]; dimensions: Dim[] };
const bp = (blueprints as unknown as Record<string, Blueprint | string>)[brand.heroImage] as Blueprint | undefined;

const tokens: Record<string, string> = {
  sqft: formatNumber(l.sqft),
  yearBuilt: String(l.yearBuilt),
  lotAcres: l.lotAcres ? String(l.lotAcres) : '',
  bedrooms: String(l.bedrooms),
  bathrooms: formatBaths(l.bathrooms),
};
// Drop a label entirely if a token it needs is missing (e.g. a condo with no lot size).
const label = (s: string) => {
  let missing = false;
  const out = s.replace(/\{\{(\w+)\}\}/g, (_, k) => { if (!tokens[k]) missing = true; return tokens[k] ?? ''; });
  return missing ? '' : out;
};

// Dimension lines and their end ticks, merged into one path.
const dimPath = bp
  ? bp.dimensions
      .map((dim) => [dim.d, ...dim.ticks.map(([x, y]) => (dim.vertical ? `M${x - 14} ${y} H${x + 14}` : `M${x} ${y - 14} V${y + 14}`))].join(' '))
      .join(' ')
  : '';
const words = brand.hero.headline.split(' ');

// Phones and tablets get the same drawing as a static image: it's rasterised once, so the
// reveal sweep runs purely on the GPU. Desktop gets the live SVG that a pen traces.
const theme = buildTheme(brand).vars;
const ink = '#FFFFFF';
const pop = theme['--c-accent-on-dark'];
const bpImage = bp
  ? 'data:image/svg+xml,' +
    encodeURIComponent(
      `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${bp.viewBox}" preserveAspectRatio="xMidYMid slice">` +
        `<g fill="none" stroke="${ink}" stroke-opacity="0.82" stroke-linecap="round" stroke-linejoin="round">` +
        `<path d="${bp.structure.join(' ')}" stroke-width="2.4"/>` +
        `<path d="${bp.openings.join(' ')}" stroke-width="1.5"/>` +
        `<path d="${bp.landscape.join(' ')}" stroke-width="1.6" opacity="0.8"/>` +
        `</g><path d="${dimPath}" fill="none" stroke="${pop}" stroke-width="1.6"/>` +
        `</svg>`,
    )
  : null;
---
<section class="hero relative isolate overflow-hidden bg-ink text-surface on-dark" aria-labelledby="hero-title" data-intro-wait>
  <!-- Inset, rounded panel (the page background shows around it). -->
  <div class="hero-par absolute inset-0 -z-10">
    <div class="hero-media absolute inset-0">
      <picture>
        <source type="image/avif" srcset={sources.avif} sizes="100vw" />
        <source type="image/webp" srcset={sources.webp} sizes="100vw" />
        <img
          src={sources.fallback}
          srcset={sources.jpg}
          sizes="100vw"
          alt={heroAlt}
          width={sources.width}
          height={sources.height}
          fetchpriority="high"
          decoding="async"
          loading="eager"
          class="h-full w-full object-cover"
        />
      </picture>

      <!-- The drafting sheet: ink with a faint grid that slides away to reveal the photo. -->
      <div class="veil" aria-hidden="true"></div>
      <div class="scan" aria-hidden="true"></div>

      {bp && (
        <div class="bp-wipe" aria-hidden="true"><div class="bp-wipe-in">
        <img class="bp bp-img" src={bpImage} alt="" decoding="async" />
        <svg class="bp bp-svg" viewBox={bp.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          <!-- One path per layer: the dash runs through each sub-path in turn, like a pen. -->
          <path class="bp-structure" d={bp.structure.join(' ')} pathLength="1" style="--d:0.15s" />
          <path class="bp-openings" d={bp.openings.join(' ')} pathLength="1" style="--d:0.75s" />
          <path class="bp-landscape" d={bp.landscape.join(' ')} pathLength="1" style="--d:0.55s" />
          <path class="bp-dims" d={dimPath} pathLength="1" style="--d:1.05s" />
          <g class="bp-labels" style="--d:1.5s">
            {bp.dimensions.map((dim) => label(dim.label) && (
              <text x={dim.x} y={dim.y} text-anchor={dim.anchor} transform={dim.rotate ? `rotate(90 ${dim.x} ${dim.y})` : undefined}>{label(dim.label)}</text>
            ))}
          </g>
        </svg>
        </div></div>
      )}
    </div>
  </div>
  <div class="scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="wrap hero-inner flex flex-col justify-end">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h1 id="hero-title" class="t-hero max-w-[13ch] text-[var(--c-on-photo)]">
          {words.map((w, n) => (
            <><span class="w"><span style={`--wd:${(0.2 + n * 0.055).toFixed(3)}s`}>{w}</span></span>{n < words.length - 1 && ' '}</>
          ))}
        </h1>
        <p class="hero-body mt-6 max-w-[34rem] text-lg leading-relaxed">{brand.hero.body}</p>
        <div class="hero-ctas mt-9 flex flex-wrap items-center gap-3">
          <a href={listingUrl(l)} class="btn btn-primary">{brand.hero.primaryCta}<span class="btn-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M3 9L9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span></a>
          <a href="/listings/" class="btn btn-ghost-light">{brand.hero.secondaryCta}</a>
        </div>
      </div>

      <div class="hero-search hidden lg:block lg:col-span-5 lg:col-start-8">
        <HeroSearch id="hs-hero" tone="glass" pictured={l} />
      </div>
    </div>
  </div>
</section>

<!-- On smaller screens the search sits just below the hero, overlapping its edge. -->
<div class="wrap relative z-10 -mt-10 lg:hidden">
  <HeroSearch id="hs-card" tone="card" pictured={l} />
</div>

<style>
  .hero {
    min-height: min(calc(100svh - 1rem), 58rem);
    display: flex;
    margin: 0.5rem;
    border-radius: 22px;
  }
  @media (min-width: 768px) { .hero { margin: 0.75rem; border-radius: var(--radius-panel); min-height: min(calc(100svh - 1.5rem), 58rem); } }
  /* Inner padding = page gutter minus the panel's inset, so copy lines up with the header. */
  .hero-inner { flex: 1; padding-top: 8rem; padding-bottom: 4.5rem; padding-inline: 0.75rem; }
  @media (min-width: 768px) { .hero-inner { padding-inline: 1.25rem; } }
  @media (min-width: 1280px) { .hero-inner { padding-inline: 2.25rem; } }

  /* Photo and drawing share one box (cover, centered) so the lines stay registered on the house. */
  .hero-media img { object-position: 50% 50%; }
  .hero-media { transform-origin: 58% 60%; }
  .bp-wipe, .bp-wipe-in { position: absolute; inset: 0; }
  .bp-wipe { overflow: hidden; }
  .bp { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bp-img { object-fit: cover; }

  .scrim {
    background:
      linear-gradient(to top, rgb(14 22 33 / 0.82) 0%, rgb(14 22 33 / 0.35) 38%, rgb(14 22 33 / 0) 62%),
      linear-gradient(to right, rgb(14 22 33 / 0.5) 0%, rgb(14 22 33 / 0) 55%),
      linear-gradient(to bottom, rgb(14 22 33 / 0.45) 0%, rgb(14 22 33 / 0) 22%);
  }
  @media (max-width: 767px) {
    .scrim {
      background: linear-gradient(to top, rgb(14 22 33 / 0.9) 0%, rgb(14 22 33 / 0.6) 45%, rgb(14 22 33 / 0.25) 75%, rgb(14 22 33 / 0.45) 100%);
    }
  }

  .hero-body { color: color-mix(in srgb, var(--c-on-photo) 86%, transparent); }


  /* Hold the entrance until the intro loader lifts away. */
  :global(html.is-loading) .hero:not([data-intro-go]) * { animation-play-state: paused !important; }

  /* Everything below exists only when motion is allowed. */
  .veil, .scan, .bp { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .veil {
      display: block;
      position: absolute;
      inset: 0;
      background-color: var(--c-deep);
      background-image:
        linear-gradient(color-mix(in srgb, var(--c-on-photo) 6%, transparent) 1px, transparent 1px),
        linear-gradient(90deg, color-mix(in srgb, var(--c-on-photo) 6%, transparent) 1px, transparent 1px);
      background-size: 64px 64px;
      background-position: center;
      transform-origin: right center;
      will-change: transform;
      animation: veil 1.3s cubic-bezier(0.76, 0, 0.18, 1) 1.9s both;
    }
    .scan {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 2px;
      background: var(--c-accent-on-dark);
      box-shadow: 0 0 34px 7px color-mix(in srgb, var(--c-accent) 75%, transparent);
      will-change: transform, opacity;
      animation: scan 1.3s cubic-bezier(0.76, 0, 0.18, 1) 1.9s both;
    }

    .bp-img { display: block; will-change: opacity; animation: bp-out 1.6s ease 3.6s forwards; }
    /* Keep the drawing quiet behind the copy and bright where the house is. */
    .bp {
      -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 20%, rgb(0 0 0 / 0.22) 27%, rgb(0 0 0 / 0.22) 74%, #000 84%);
      mask-image: linear-gradient(180deg, #000 0%, #000 20%, rgb(0 0 0 / 0.22) 27%, rgb(0 0 0 / 0.22) 74%, #000 84%);
    }
    @media (min-width: 1024px) {
      .bp {
        -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.2) 0%, rgb(0 0 0 / 0.2) 30%, #000 48%);
        mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.2) 0%, rgb(0 0 0 / 0.2) 30%, #000 48%);
      }
    }
    .bp path {
      fill: none;
      stroke: color-mix(in srgb, var(--c-on-photo) 82%, transparent);
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    path.bp-openings { stroke-width: 1.5; }
    path.bp-landscape { stroke-width: 1.6; opacity: 0.8; }
    path.bp-dims { stroke-width: 1.6; stroke: var(--c-accent-on-dark); }
    .bp-labels text {
      fill: var(--c-accent-on-dark);
      font-family: var(--f-body);
      font-size: 19px;
      font-weight: 560;
      letter-spacing: 0.04em;
    }

    /*
     * Phones and tablets: the finished drawing is uncovered by a sweep that runs
     * on the GPU (two counter-moving transforms), so slower devices stay smooth.
     */
    .bp-wipe { will-change: transform; animation: wipe-out 1.5s cubic-bezier(0.65, 0, 0.25, 1) 0.15s both; }
    .bp-wipe-in { will-change: transform; animation: wipe-in 1.5s cubic-bezier(0.65, 0, 0.25, 1) 0.15s both; }

    /* Desktop: a pen traces each layer of the drawing in turn. */
    @media (min-width: 1024px) and (hover: hover) {
      .bp-wipe, .bp-wipe-in { animation: none; will-change: auto; }
      .bp-img { display: none; }
      .bp-svg { display: block; animation: bp-out 1.6s ease 3.6s forwards; }
      .bp path {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: draw 1.6s cubic-bezier(0.45, 0.05, 0.35, 1) var(--d, 0s) forwards;
      }
      path.bp-structure { animation-duration: 1.7s; }
      path.bp-openings { animation-duration: 1.2s; }
      path.bp-landscape { animation-duration: 1.5s; }
      path.bp-dims { animation-duration: 0.9s; }
      .bp-labels text { opacity: 0; animation: fade-in 0.6s ease var(--d, 0s) forwards; }
    }

    .hero-media { animation: settle 3.4s var(--ease-out-soft) 1.95s both; }
    /* The darkening for legibility arrives with the photo, so it doesn't bury the drawing. */
    .scrim { animation: fade-in 1.1s ease 2.1s both; opacity: 0; }

    .t-hero .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.1em; margin-bottom: -0.1em; }
    .t-hero .w > span { display: inline-block; animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) var(--wd) both; }
    /* Slide only, never fade: text that is half-transparent fails contrast checks while it animates. */
    .hero-ctas { animation: slide-up 0.8s var(--ease-out-soft) 0.75s both; }
    .hero-search { animation: lift 0.9s var(--ease-out-soft) 2.6s both; }

    /* On scroll the photo drifts slower than the page and the copy eases away. */
    @supports (animation-timeline: scroll()) {
      .hero-par { animation: drift linear both; animation-timeline: scroll(root block); animation-range: 0 100vh; }
      .hero-inner { animation: ease-away linear both; animation-timeline: scroll(root block); animation-range: 15vh 85vh; }
    }
  }

  @keyframes wipe-out { from { transform: translateX(-100%); } to { transform: none; } }
  @keyframes wipe-in { from { transform: translateX(100%); } to { transform: none; } }
  @keyframes veil { from { transform: scaleX(1); } to { transform: scaleX(0); } }
  @keyframes scan {
    0% { transform: translateX(0); opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateX(100vw); opacity: 0; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-in { to { opacity: 1; } }
  /* Once the photo is in, the drawing lingers on the house, then lifts off. */
  @keyframes bp-out { 0% { opacity: 1; } 40% { opacity: 0.6; } 100% { opacity: 0; visibility: hidden; } }
  @keyframes settle { from { transform: scale(1.06); } to { transform: scale(1); } }
  @keyframes rise { from { transform: translateY(108%); } to { transform: none; } }
  @keyframes slide-up { from { transform: translateY(14px); } to { transform: none; } }
  @keyframes lift { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes drift { to { transform: translateY(20%); } }
  @keyframes ease-away { to { opacity: 0; transform: translateY(-6%); } }
</style>
